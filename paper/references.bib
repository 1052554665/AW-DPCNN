@article{ZHANG2026106301,
title = {Bearing fault diagnosis via {PCA}-constrained recursive angular matrix and attention-enhanced {CNN}},
journal = {Digital Signal Processing},
volume = {182},
pages = {106301},
year = {2026},
issn = {1051-2004},
doi = {https://doi.org/10.1016/j.dsp.2026.106301},
url = {https://www.sciencedirect.com/science/article/pii/S1051200426004197},
author = {Long Zhang and Jianping Yu and Jiayang Liu and Hesheng Liu and Faxian Wang and Dongkai Liu and Liangliang Sun and Yuanming Pan},
keywords = {Bearing fault diagnosis, Principal component analysis, Recursive angular matrix, Attention mechanism, Signal-to-image transformation},
abstract = {To address the challenges of insufficient feature representation and limited time–frequency characterization capability in traditional one-dimensional bearing vibration signals, this study proposes a novel fault diagnosis framework that integrates a principal component analysis–constrained recursive angular matrix (PCA-RAM) with an attention-enhanced convolutional neural network (CNN). First, PCA is employed to capture the dominant global variation patterns of vibration signals. Based on these patterns, a recursive angular matrix is constructed, thereby converting the one-dimensional time series into texture-rich RGB images. This transformation facilitates the multi-scale representation of fault-related impulse characteristics. Subsequently, a lightweight CNN architecture incorporating a convolutional block attention module (CBAM) is developed, in which the dual mechanisms of channel-wise and spatial attention selectively emphasize discriminative fault features while suppressing redundant or irrelevant information. The training process is optimized using the sparse categorical cross-entropy loss. Experimental results on the Case Western Reserve University bearing dataset demonstrate that the proposed method achieves an average classification accuracy of 99.10% on a five-class fault diagnosis task, significantly surpassing conventional image-based transformation methods such as gramian angular difference field and gramian angular summation field (GASF). Furthermore, the proposed model attains a peak diagnostic accuracy of 99.50%, demonstrating its superiority over other representative baseline networks. Furthermore, on the proprietary QPZZ-II dataset, the proposed approach attains an average accuracy of 91.3%, representing a 17.8% improvement over the GASF-based approach. Compared with mainstream deep learning models such as MobileNetV2, GoogLeNet, and VGG16, the proposed method maintains superior diagnostic performance while reducing model parameters by approximately 80–98%. These results demonstrate the effectiveness, lightweight nature, and strong generalization capability of the proposed framework for industrial bearing fault diagnosis.}
}

