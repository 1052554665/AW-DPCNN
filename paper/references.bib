@article{JIANG2026113823,
title = {Weak vibration energy powered acceleration monitoring system for bearing fault diagnosis},
journal = {Mechanical Systems and Signal Processing},
volume = {244},
pages = {113823},
year = {2026},
issn = {0888-3270},
doi = {https://doi.org/10.1016/j.ymssp.2025.113823},
url = {https://www.sciencedirect.com/science/article/pii/S0888327025015249},
author = {Zhichao Jiang and Zefang Dong and Xianpeng Fu and Zheng Gao and Likun Gong and Jie Cao and Youchao Qi and Tingshan Liu and Wei Li and Chi Zhang},
keywords = {Triboelectric nanogenerator, Vibration energy harvesting, Self-powered, Acceleration monitoring, Bearing fault diagnosis},
abstract = {Vibration monitoring technology has been widely applied in industrial, transportation, and other environments. Traditional wired and battery-powered methods face challenges such as complex wiring, high energy consumption, and environmental pollution. Here, we have developed a self-powered wireless acceleration monitoring system (SWAMS) for monitoring the operating condition of bearings in a weak vibration environment. A vibration triboelectric nanogenerator array (WEB-TENGs) is designed to efficiently harvest energy from micro-amplitude vibration, and supplies power to SWAMS. The WEB-TENGs achieves a notable peak power density of 4.3 μW/cm3 under an acceleration of 0.07 g (10 µm excitation amplitude at 42.1 Hz). The WEB-TENGs can efficiently charge lithium batteries by a power management module. The SWAMS can transmit vibration data within each hour without additional power consumption, using a timing circuit module. The collected acceleration data from the bearing housing is wirelessly transmitted to a PC via a transmission module. Fault identification of bearings is performed using a hybrid CNN-LSTM model, achieving a classification accuracy of 98 % on the test set. The SWAMS enables self-powered vibration monitoring of industrial equipment in unattended environments, providing a sustainable and maintenance-free solution for fault diagnosis.}
}

@article{COSTA2026113711,
title = {Vibration data-driven supervised learning for low-speed bearing fault diagnosis using classical and nonlinear features},
journal = {Mechanical Systems and Signal Processing},
volume = {243},
pages = {113711},
year = {2026},
issn = {0888-3270},
doi = {https://doi.org/10.1016/j.ymssp.2025.113711},
url = {https://www.sciencedirect.com/science/article/pii/S0888327025014128},
author = {Thiago B. Costa and João L.L. Soares and Jonatas C. {da Silva} and Walter S. Sousa and Alexandre L.A. Mesquita and André L.A. Mesquita and Jullyane M.S. {de Figueiredo} and Danilo de S. Braga},
keywords = {Vibration signal, Low-speed bearing fault diagnosis, Largest Lyapunov exponent, Feature selection, Machine learning},
abstract = {Fault diagnosis of low-speed bearings via vibration analysis is challenging due to the low energy of fault signatures and the high susceptibility to noise, particularly in early degradation stages. Recent deep-learning approaches have shown promising results in mitigating those limitations, yet many require large datasets, high sampling rates, or complex preprocessing for ensuring generalization. This study proposes a supervised learning framework optimized for limited data scenarios, advancing the state-of-the-art through four contributions. First, Rosenstein’s Largest Lyapunov Exponent (LLE) algorithm is modified by replacing Euclidean with Pearson correlation distance for nearest-neighbor identification in reconstructed phase space, enhancing class separability. Second, a hybrid feature set integrates classical time-domain indicators with nonlinear measures (LLE and Higuchi Fractal Dimension), tailored for incipient-fault conditions. Third, the influence of vibration signal window size, expressed in shaft revolutions, is systematically evaluated with the use of Welch’s t-test, providing guidelines for balancing sensitivity and computational cost. Finally, the framework is validated on two datasets, namely, (1) an experimental set simulating abrasive wear on bearing outer races at three severities under varied loads, representing a non-periodic defect type rarely studied, and (2) naturally degraded industrial pulley bearings. The results show high classification accuracy without complex preprocessing, confirming suitability for predictive maintenance in data- and resource-constrained environments. The approach offers a compact, interpretable, and data-efficient solution for early fault detection in low-speed bearings, with potential for deployment in industrial contexts where robustness and scalability are critical.}
}

