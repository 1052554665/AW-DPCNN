@article{WANG2026105996,
title = {A novel CNN-transformer integrated with cross-attention mechanism for intelligent diagnosis of rolling bearing faults},
journal = {Digital Signal Processing},
volume = {175},
pages = {105996},
year = {2026},
issn = {1051-2004},
doi = {https://doi.org/10.1016/j.dsp.2026.105996},
url = {https://www.sciencedirect.com/science/article/pii/S1051200426001156},
author = {Mingling Wang and Zhiyang Wang},
keywords = {Fault diagnosis, Cross-attention, Rolling bearing, Transformer, Convolutional neural network, Variational mode decomposition},
abstract = {Deep learning approaches utilizing Transformer neural networks have been extensively applied to rolling bearing fault diagnosis. However, conventional self-attention-based Transformers are constrained by their single-sequence processing paradigm, which often limits their capacity to effectively capture dual-domain time-frequency fault characteristics from raw vibration signals. To address this issue, this paper proposes a parallel CNN-Transformer diagnostic model integrated with a cross-attention mechanism (CTCA). The model first employs a hybrid preprocessing strategy combining Fast Fourier Transform (FFT) and Variational Mode Decomposition (VMD) to construct multi-dimensional time–frequency representations of the input signals. Architecturally, it parallelizes a custom VGG-style Convolutional Neural Network (CNN) with a shifted-window Transformer, enabling simultaneous yet decoupled processing of vibration responses. Specifically, the CNN branch captures local spatial features to compensate for the Transformer's limited inductive bias, whereas the Transformer branch models long-range sequential dependencies via self-attention. A key contribution is the novel cross-attention fusion module, which dynamically establishes interactive correlations between the multi-dimensional features extracted from both branches. This facilitates the integration of local and global representations, reduces latent feature information loss, and enhances the comprehensiveness of bearing degradation characterization. Experimental results on five benchmark bearing fault datasets show that the proposed CTCA model achieves an average diagnostic accuracy of 96.25%, outperforming a standard Transformer baseline by 8.6 percentage points. Notably, it maintains an accuracy above 93.74% under 6 dB noise conditions, demonstrating strong robustness against signal contamination.}
}


@article{SMITH2015100,
title = {Rolling element bearing diagnostics using the Case Western Reserve University data: A benchmark study},
journal = {Mechanical Systems and Signal Processing},
volume = {64-65},
pages = {100-131},
year = {2015},
issn = {0888-3270},
doi = {https://doi.org/10.1016/j.ymssp.2015.04.021},
url = {https://www.sciencedirect.com/science/article/pii/S0888327015002034},
author = {Wade A. Smith and Robert B. Randall},
keywords = {Rolling element bearing, Bearing diagnostics},
abstract = {Vibration-based rolling element bearing diagnostics is a very well-developed field, yet researchers continue to develop new diagnostic algorithms quite frequently. Over the last decade, data from the Case Western Reserve University (CWRU) Bearing Data Center has become a standard reference used to test these algorithms, yet without any recognised benchmark it is difficult to properly assess the performance of any proposed diagnostic methods. There is, then, a clear need to examine the data thoroughly and to categorise it appropriately, and this paper intends to fulfil that objective. To do so, three established diagnostic techniques are applied to the entire CWRU data set, and the diagnostic outcomes are provided and discussed in detail. Recommendations are given as to how the data might best be used, and also on how any future benchmark data should be generated. Though intended primarily as a benchmark to aid in testing new diagnostic algorithms, it is also hoped that much of the discussion will have broader applicability to other bearing diagnostics cases.}
}

