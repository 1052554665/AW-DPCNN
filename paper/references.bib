@article{DUAN2026122469,
title = {SimAM-enhanced ResNet for fault diagnosis of wind turbine gearboxes based on hinged {FBG} vibration sensing},
journal = {Measurement},
volume = {286},
pages = {122469},
year = {2026},
issn = {0263-2241},
doi = {https://doi.org/10.1016/j.measurement.2026.122469},
url = {https://www.sciencedirect.com/science/article/pii/S0263224126021780},
author = {Xuetao Duan and Yuhan Peng and Haoyuan Tian and Hong Liu and Wentao Zhang and Tanglong Liu and Jiaqi Liu and Ketan Chen and Zhiqing Shu and Zhixian Zhang and Zhiwei Yu and Weigen Chen},
keywords = {FBG, Wind turbine gearbox, Fault vibration, OOA-VMD, ResNet18-SimAM},
abstract = {Mechanical abrasion and damage defects in wind turbine gearboxes are critical factors inducing catastrophic failures of the units, yet their vibration signal monitoring and early fault warning pose significant challenges. This paper designs a hinged fiber Bragg grating (FBG) vibration sensor and proposes an adaptive signal denoising method based on the Octopus Optimization Algorithm (OOA)-optimized Variational Mode Decomposition (VMD) to obtain high-quality 1D vibration signals. The Markov Transition Field (MTF) is employed for time–frequency conversion to generate 2D images, which are then input into a ResNet18 network integrated with different attention mechanisms, such as Coordinate Attention (CA), Efficient Channel Attention (ECA), and Simple Parameter-Free Attention (SimAM), for training and comparison. Experimental results demonstrate that under the SimAM enhancement, the proposed network is most effective in extracting gearbox fault features, achieving a high accuracy of 98.11%. The Macro F1-score is improved by up to 0.1119 compared to other mechanisms, and the diagnostic accuracy of this method is improved by up to 4.83% compared to representative deep learning models such as DenseNet, MobileNet, and EfficientNet. This study indicates that the synergistic operation scheme of the proposed hinged FBG vibration sensor and the SimAM-enhanced network model will provide a novel technical solution for the accurate monitoring and intelligent diagnosis of power equipment.}
}

@article{HE2020542,
title = {A new hybrid deep signal processing approach for bearing fault diagnosis using vibration signals},
journal = {Neurocomputing},
