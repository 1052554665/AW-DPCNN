@article{YI2025116881,
title = {VibrMamba: A lightweight Mamba based fault diagnosis of rotating machinery using vibration signal},
journal = {Measurement},
volume = {249},
pages = {116881},
year = {2025},
issn = {0263-2241},
doi = {https://doi.org/10.1016/j.measurement.2025.116881},
url = {https://www.sciencedirect.com/science/article/pii/S0263224125002404},
author = {Haiming Yi and Danyu Li and Zhenyong Lu and Yuhong Jin and Hao Duan and Lei Hou and Faisal Z. Duraihem and Emad Mahrous Awwad and Nasser. A. Saeed},
keywords = {Mamba model, State space models, Kolmogorov-Arnold networks, Fault diagnosis, Lightweight model},
abstract = {Mamba model does not rely on self-attention mechanism, but uses State Space Models (SSMs), so it can effectively deal with long sequence language tasks and visual classification tasks. However, Mamba-based models have not been applied and tried in the field of fault diagnosis. In this paper, we introduce Mamba model into the fault diagnosis of rotating machinery which directly take one-dimensional vibration signal as input. The proposed VibrMamba model integrates a bidirectional SSMs backbone, combining forward and backward processing, and replaces traditional linear projection layers with Kolmogorov-Arnold Networks (KAN) to enhance efficiency and accuracy. VibrMamba is validated on six classification tasks across CWRU, XJTU, HIT, and PHM-Beijing 2024 datasets, achieving diagnostic accuracies of 99.77%, 99.84%, 99.95%, 87.63%, 99.49%, and 94.59%, respectively. These results surpass those of the traditional 1D Mamba model and other existing methods. Comparative and ablation experiments demonstrate that bidirectional SSMs significantly improve diagnostic accuracy, while KAN layers reduce computational parameters, enhancing efficiency. VibrMamba exhibits clear advantages over mainstream CNN and Transformer fault diagnosis models, offering a lightweight and accurate solution for industrial applications.}
}


