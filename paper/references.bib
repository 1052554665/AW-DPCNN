@article{GAO2026114419,
title = {An interpretable adaptive denoising convolutional network for intelligent fault diagnosis of rotating machinery},
journal = {Mechanical Systems and Signal Processing},
volume = {255},
pages = {114419},
year = {2026},
issn = {0888-3270},
doi = {https://doi.org/10.1016/j.ymssp.2026.114419},
url = {https://www.sciencedirect.com/science/article/pii/S0888327026005765},
author = {Tianhong Gao and Haiping Zhu and Jun Wu and Zirui Li},
keywords = {Intelligentfault diagnosis, Interpretability, Fusion wavelet convolution, Denoising, Sparse representation},
abstract = {Deep learning has achieved significant success in intelligent fault diagnosis owing to its powerful nonlinear mapping capabilities. However, the lack of interpretability of deep learning-based fault diagnosis methods with black-box characteristics has seriously hindered their widespread industrial application. To address this issue, an interpretable adaptive denoising convolutional network (IADC-Net) is proposed for intelligent fault diagnosis of rotating machinery in this paper, which constructs a comprehensive interpretability framework. In this method, the interpretable signal processing layer is driven by adaptive fusion denoising wavelet convolution (AFDWC) module, enhancing the model’s generalization capabilities in various scenarios. The AFDWC integrated with multiple wavelet basis kernel can capture abundant multi-scale mechanical fault information. The adaptive soft threshold denoising (ASTD) dynamically removes noise interference on channel features, and the energy-entropy ratio channel weighting adaptively highlights frequency bands more relevant to faults. Then, the interpretable feature extraction layer leverages the sparse interaction characteristics of traditional convolutions to elucidate its intrinsic mathematical implications through sparse representation, which is of great significance to the engineering applications of various convolutional networks. And, the interpretable result analysis layer visualizes the model results with attention weight and output features to help users understand the decision process and trust diagnosis results. Finally, the effectiveness of the proposed method is verified and analyzed by the public fault datasets and the industrial robot experimental platform, demonstrating the interpretability of model, the rationality of network structure and the superiority of diagnostic performance. The code library is available at: https://github.com/GTH25/IADC-Net.}
}


